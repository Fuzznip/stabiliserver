WEBHOOK=<Discord Forum Webhook URL>
INPUT_SHEET=<Name of the Whitelist Tab in Sheets>
OUTPUT_SHEET=<Name of the Output Tab in Sheets>

S3_BUCKET_NAME=<S3 bucket for uploading dink loot drops>
AWS_ACCESS_KEY_ID=<Access key to the stability aws user>
AWS_SECRET_ACCESS_KEY=<Secret key to the stability aws user>
AWS_REGION=<Region for s3 bucket>

# Set to false to stop recording clan collection log drops (CLOG submissions
# and the S3 screenshot uploads they trigger). Anything other than
# false/0/no/off leaves the feature on.
CLAN_COLLECTION_LOG_ENABLED=true
